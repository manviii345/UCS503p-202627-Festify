// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  role          String         // 'ADMIN' or 'STUDENT'
  ownedFests    Fest[]         @relation("FestOwner")
  events        Event[]        @relation("EventCreator")
  registrations Registration[]
}

model Fest {
  id         Int         @id @default(autoincrement())
  name       String
  startDate  String?
  endDate    String?
  branding   String?
  ownerId    Int
  owner      User        @relation("FestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  events        Event[]
  venueZones    VenueZone[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
}

model Event {
  id                  Int            @id @default(autoincrement())
  name                String
  description         String
  image               String?
  category            String
  date                String
  startTime           String
  endTime             String
  venue               String
  maxParticipants     Int
  registrationDeadline String
  rules               String?
  prizes              String?
  contact             String?
  status              String         @default("Upcoming")
  createdAt           DateTime       @default(now())

  createdById         Int
  createdBy           User           @relation("EventCreator", fields: [createdById], references: [id])
  festId              Int?
  fest                Fest?          @relation(fields: [festId], references: [id], onDelete: Cascade)
  zoneId              Int?
  zone                VenueZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  registrations       Registration[]
  notifications       Notification[]
}

// VenueZone: represents a polygon zone or point landmark on the campus venue map.
// 'coordinates' stores GeoJSON geometry format (rendered via PostGIS ST_AsGeoJSON / ST_Contains).
model VenueZone {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   @default("zone")       // "zone" | "landmark"
  category    String   @default("other")      // "stage" | "food" | "gate" | "restroom" | "parking" | etc.
  coordinates String                          // GeoJSON coordinate array string
  color       String   @default("#F4C430")
  description String?
  icon        String?
  festId      Int
  fest        Fest     @relation(fields: [festId], references: [id], onDelete: Cascade)
  events      Event[]
  createdAt   DateTime @default(now())
}

model Registration {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  qrToken     String    @unique
  status      String    @default("REGISTERED") // "REGISTERED" | "CHECKED_IN" | "CANCELLED"
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, eventId])
}

model Notification {
  id            Int      @id @default(autoincrement())
  festId        Int
  fest          Fest     @relation(fields: [festId], references: [id], onDelete: Cascade)
  message       String
  targetType    String   @default("fest") // "fest" | "event"
  targetEventId Int?
  targetEvent   Event?   @relation(fields: [targetEventId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
}

